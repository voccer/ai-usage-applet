{
    "providers-header": {
        "type": "header",
        "description": "Providers"
    },
    "enable-claude": {
        "type": "checkbox",
        "default": true,
        "description": "Show Claude usage",
        "tooltip": "Hide the Claude reading and stop polling it"
    },
    "enable-codex": {
        "type": "checkbox",
        "default": true,
        "description": "Show Codex usage",
        "tooltip": "Hide the Codex reading and stop running the adapter"
    },
    "polling-header": {
        "type": "header",
        "description": "Polling"
    },
    "update-interval": {
        "type": "spinbutton",
        "default": 5,
        "min": 1,
        "max": 60,
        "step": 1,
        "units": "minutes",
        "description": "Update interval",
        "tooltip": "Normal polling interval for Claude and Codex usage"
    },
    "paths-header": {
        "type": "header",
        "description": "Paths"
    },
    "claude-credentials-path": {
        "type": "entry",
        "default": "~/.claude/.credentials.json",
        "description": "Claude credentials path",
        "tooltip": "OAuth credentials maintained by Claude Code",
        "dependency": "enable-claude"
    },
    "claude-desktop-entry": {
        "type": "entry",
        "default": "com.anthropic.Claude.desktop",
        "description": "Claude desktop entry",
        "tooltip": "Desktop entry launched when the Claude reading is clicked",
        "dependency": "enable-claude"
    },
    "codex-executable-path": {
        "type": "entry",
        "default": "~/Desktop/shared/config/fnm/aliases/default/bin/codex",
        "description": "Codex executable path",
        "dependency": "enable-codex",
        "tooltip": "Must be a stable path. Do not use the output of `which codex` under fnm: that is an ephemeral /run/user/... multishell path that dies with the shell."
    },
    "codex-home-path": {
        "type": "entry",
        "default": "~/Desktop/shared/config/codex",
        "description": "Codex configuration directory",
        "dependency": "enable-codex"
    },
    "codex-desktop-entry": {
        "type": "entry",
        "default": "codex-desktop.desktop",
        "description": "Codex desktop entry",
        "tooltip": "Desktop entry launched when the Codex reading is clicked",
        "dependency": "enable-codex"
    }
}
